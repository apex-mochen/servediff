import json
import os
import tempfile

import torch
from safetensors.torch import save_file

from vllm import LLM

H, I, E, HEADS, KV, D, V = 512, 256, 8, 4, 2, 128, 256


def nvfp4(prefix, out, inp):
    return {
        f"{prefix}.weight_packed": torch.randint(0, 256, (out, inp // 2), dtype=torch.uint8),
        f"{prefix}.weight_scale": torch.full((out, inp // 16), 0.5).to(torch.float8_e4m3fn),
        f"{prefix}.weight_global_scale": torch.tensor([100.0]),
    }


def write_checkpoint(path):
    bf16, p = torch.bfloat16, "model.layers.0"
    t = {
        "model.embed_tokens.weight": torch.randn(V, H, dtype=bf16) * 0.02,
        "model.norm.weight": torch.ones(H, dtype=bf16),
        "lm_head.weight": torch.randn(V, H, dtype=bf16) * 0.02,
        f"{p}.input_layernorm.weight": torch.ones(H, dtype=bf16),
        f"{p}.post_attention_layernorm.weight": torch.ones(H, dtype=bf16),
        f"{p}.self_attn.q_norm.weight": torch.ones(D, dtype=bf16),
        f"{p}.self_attn.k_norm.weight": torch.ones(D, dtype=bf16),
        f"{p}.mlp.gate.weight": torch.randn(E, H, dtype=bf16) * 0.02,
    }
    for name, out, inp in (("q_proj", HEADS * D, H), ("k_proj", KV * D, H),
                           ("v_proj", KV * D, H), ("o_proj", H, HEADS * D)):
        t |= nvfp4(f"{p}.self_attn.{name}", out, inp)
    for e in range(E):
        for name, out, inp in (("gate_proj", I, H), ("up_proj", I, H), ("down_proj", H, I)):
            t |= nvfp4(f"{p}.mlp.experts.{e}.{name}", out, inp)
    save_file(t, os.path.join(path, "model.safetensors"))
    weights = {"num_bits": 4, "type": "float", "strategy": "tensor_group",
               "group_size": 16, "symmetric": True, "dynamic": False}
    config = {
        "architectures": ["Qwen3MoeForCausalLM"], "model_type": "qwen3_moe",
        "hidden_size": H, "intermediate_size": 2 * H, "moe_intermediate_size": I,
        "num_hidden_layers": 1, "num_attention_heads": HEADS, "num_key_value_heads": KV,
        "head_dim": D, "num_experts": E, "num_experts_per_tok": 2, "decoder_sparse_step": 1,
        "mlp_only_layers": [], "norm_topk_prob": True, "vocab_size": V,
        "max_position_embeddings": 64, "rms_norm_eps": 1e-6, "tie_word_embeddings": False,
        "torch_dtype": "bfloat16",
        "quantization_config": {
            "quant_method": "compressed-tensors", "format": "nvfp4-pack-quantized",
            "config_groups": {"group_0": {"targets": ["Linear"], "weights": weights,
                                          "input_activations": None}},
            "ignore": ["lm_head", "re:.*mlp.gate$"],
        },
    }
    with open(os.path.join(path, "config.json"), "w") as f:
        json.dump(config, f)


if __name__ == "__main__":
    with tempfile.TemporaryDirectory() as path:
        write_checkpoint(path)
        llm = LLM(
            model=path,
            skip_tokenizer_init=True,
            enforce_eager=True,
            max_model_len=32,
            kv_cache_memory_bytes=16 << 20,
            gpu_memory_utilization=0.05,
            model_loader_extra_config={"enable_weights_track": True},
        )
        print("loaded:", type(llm).__name__)
