from vllm.config import set_current_vllm_config
from vllm.distributed import init_distributed_environment, initialize_model_parallel
from vllm.engine.arg_utils import EngineArgs
from vllm.model_executor.layers.linear import LinearBase
from vllm.model_executor.model_loader import get_model_loader
from vllm.utils.network_utils import get_open_port

vllm_config = EngineArgs(
    model="mistralai/Ministral-3-3B-Instruct-2512",
    config_format="hf",
    load_format="dummy",
    skip_tokenizer_init=True,
    enforce_eager=True,
    max_model_len=1024,
    hf_overrides={
        "text_config": {"num_hidden_layers": 1},
        "vision_config": {"num_hidden_layers": 1},
    },
).create_engine_config()

with set_current_vllm_config(vllm_config):
    init_distributed_environment(
        world_size=1,
        rank=0,
        local_rank=0,
        distributed_init_method=f"tcp://127.0.0.1:{get_open_port()}",
        backend="nccl",
    )
    initialize_model_parallel(1, 1)
    model = get_model_loader(vllm_config.load_config).load_model(
        vllm_config=vllm_config, model_config=vllm_config.model_config
    )

print("modules_to_not_convert after mapping:", vllm_config.quant_config.ignored_layers)
counts: dict[tuple[str, str], int] = {}
for name, module in model.named_modules():
    if isinstance(module, LinearBase):
        key = (name.split(".")[0], type(module.quant_method).__name__)
        counts[key] = counts.get(key, 0) + 1
for (part, method), n in sorted(counts.items()):
    print(f"{part:22s} {method:24s} {n} linear layers")
